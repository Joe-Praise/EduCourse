# Vite env vars must be prefixed with VITE_ to be exposed to the client bundle.
# Copy to `.env.local` for local development.

# Sentry error tracking — leave empty to disable
VITE_SENTRY_DSN=
VITE_MODE=
VITE_PORT=
VITE_PRODUCTION_URL=

# Feature flags. Each VITE_FF_<name> overrides the default in
# src/lib/featureFlags.ts. Values: true | false | 1 | 0. Anything else falls
# back to the default. Leave commented to use defaults.
# VITE_FF_liveNotifications=true
# VITE_FF_aiRecommendations=false
# VITE_FF_aiLearningPaths=false
# VITE_FF_aiQuizzes=false
# VITE_FF_searchPage=true
# VITE_FF_certificates=true